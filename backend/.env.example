ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://noolagam:noolagam@db:5432/noolagam
REDIS_URL=redis://redis:6379/0

# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RESET_TOKEN_MINUTES=30
BCRYPT_ROUNDS=12

# Comma-separated. Web pages on another origin, and the Android app (http or https://localhost).
CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost
FRONTEND_URL=http://localhost:5173

# Must be true over HTTPS. False only for local http:// development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Uploaded book photos. Keep this on storage that survives restarts.
MEDIA_DIR=/data/uploads

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Noolagam <no-reply@noolagam.local>
