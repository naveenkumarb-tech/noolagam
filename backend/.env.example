ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://noolagam:noolagam@db:5432/noolagam
REDIS_URL=redis://redis:6379/0

# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RESET_TOKEN_MINUTES=30
VERIFY_TOKEN_HOURS=24
BCRYPT_ROUNDS=12

# Comma-separated. Only needed when the frontend is not served from the same origin as the API.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Must be true over HTTPS. False only for local http:// development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Noolagam <no-reply@noolagam.local>
