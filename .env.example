# Copy this file to .env. Git ignores .env, so your password stays on this computer.
# Apply changes with: docker compose up -d
# Leave a value blank to keep the development default.

# --- Real email ---------------------------------------------------------------
# All blank: every email goes to Mailpit at http://localhost:8025.
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, and enter it WITHOUT its spaces.
# The port must support STARTTLS, such as 587. Port 465 is not supported.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Gmail requires this to be your own address.
EMAIL_FROM=

# --- Links in emails ----------------------------------------------------------
# Blank means http://localhost:5173, which only opens on this computer.
# Use your laptop's address to open links on your phone, on the same Wi-Fi.
FRONTEND_URL=
