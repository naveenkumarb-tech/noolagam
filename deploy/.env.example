# Copy to deploy/.env on the server, which Git ignores, and fill in every value.

# The server's address, without https://, such as noolagam.duckdns.org
DOMAIN=

# Letters and numbers only, as this goes inside a URL. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# At least 32 characters. Generate with: openssl rand -hex 48
JWT_SECRET=

# Password reset emails. For Gmail, SMTP_PASSWORD is an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Noolagam <you@example.com>"
